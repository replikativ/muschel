*.log
.nrepl-port

# shadow-cljs / npm
.shadow-cljs/
node_modules/

# build outputs — regenerated by `npm run build:*`, served from unpkg
# after `clojure -T:build npm-publish`. Not committed.
# (dist/muschel.d.ts IS committed — hand-written TypeScript types.)
dist/muschel.js
dist/playground/

# npm-package/ holds a few tracked source files (LICENSE, README.md,
# index.d.ts, package.template.json) plus build outputs that are
# regenerated on every `clojure -T:build npm-pack` / `npm-publish`.
# The outputs aren't committed — they bloat history and any diff is
# noise. Matches datahike's pattern.
npm-package/muschel.js
npm-package/muschel.js.map
npm-package/package.json
npm-package/dist/

# Private corpus — 485-line sample of real LLM-emitted bash from
# session transcripts. Kept locally for richer regression coverage;
# never committed (contains internal paths / project names).
# The public test/muschel/{parse,lex}_corpus.txt is a hand-curated
# subset safe for the open-source repo.
test/muschel/parse_corpus_private.txt
test/muschel/lex_corpus_private.txt
