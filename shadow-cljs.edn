{:source-paths ["src" "test"]

 :dependencies [[org.clojure/clojurescript "1.11.132"]]

 ;; Top-level dev-http: {port → roots}. Serves the static HTML from
 ;; `docs/playground/` AND the freshly-built bundle from
 ;; `dist/playground/`. Open http://localhost:8888/index.html after
 ;; `npm run watch:playground`.
 :dev-http {8888 ["docs/playground" "dist/playground"]}

 :builds
 {:node-tests
  {:target    :node-test
   :output-to "out/node-tests.js"
   :ns-regexp ".*-test"
   :compiler-options {:infer-externs true}}

  ;; CI build — matches what the replikativ/clj-tools orb expects.
  ;; Same content as :node-tests, different output path so caching
  ;; for the CI job stays separate.
  :ci
  {:target    :node-test
   :output-to "out/ci-tests.js"
   :ns-regexp ".*-test"
   :compiler-options {:infer-externs true}}

  :playground
  {:target     :browser
   :output-dir "dist/playground"
   :modules    {:playground {:entries [muschel.playground]
                             :init-fn muschel.playground/start}}
   :compiler-options {:infer-externs true}}

  ;; npm module — usable from plain JS / TypeScript. Compiled into
  ;; `npm-package/` (the directory `npm publish` is run from).
  :npm
  {:target    :node-library
   :output-to "npm-package/muschel.js"
   :exports   {;; Parsing + permit
               :parse              muschel.js-api/parse
               :check              muschel.js-api/check
               :defaultRules       muschel.js-api/defaultRules
               :denyAllPrompter    muschel.js-api/denyAllPrompter
               :allowAllPrompter   muschel.js-api/allowAllPrompter

               ;; Env + session
               :newEnv             muschel.js-api/newEnv
               :getVar             muschel.js-api/getVar
               :setVar             muschel.js-api/setVar
               :atomSession        muschel.js-api/atomSession
               :sessionCwd         muschel.js-api/sessionCwd

               ;; Hosts + filesystems
               :nodeHost           muschel.js-api/nodeHost
               :browserHost        muschel.js-api/browserHost
               :virtualFS          muschel.js-api/virtualFS
               :stockTools         muschel.js-api/stockTools

               ;; Nested objects: fs.*, budget.*
               :fs                 muschel.js-api/fs
               :budget             muschel.js-api/budget

               ;; Execution
               :run                muschel.js-api/run}
   :compiler-options {:infer-externs true}}}}
