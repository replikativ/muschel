;; muschel — bash → AST → Clojure for safely runnable LLM-emitted shell.
;;
;; Layers:
;;   muschel.lex      hand-written tokenizer (.cljc, sci-safe)
;;   muschel.ast      AST node ctors, predicates, walk/zip
;;   muschel.parse    recursive-descent parser over the token stream
;;   muschel.env      immutable shell-environment value
;;   muschel.expand   POSIX expansion order on (ast, env) → expanded ast
;;   muschel.permit   allowlist/denylist on AST
;;   muschel.host     Host protocol (jvm / node / browser impls)
;;   muschel.exec     executor over the AST
;;   muschel.session  forkable session (atom + optional spindel)
;;   muschel.core     public facade
{:paths ["src" "resources"]

 :deps {org.clojure/clojure   {:mvn/version "1.12.0"}
        org.clojure/tools.cli {:mvn/version "1.1.230"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        babashka/process      {:mvn/version "0.6.25"}
        babashka/fs           {:mvn/version "0.5.22"}
        org.babashka/sci      {:mvn/version "0.12.51"}}

 :aliases
 {;; Run JVM tests
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/sha "7284cda41fb9edc0f3bc6b6185cfb7138fc8a023"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; CI alias for JVM tests (matches the replikativ/clj-tools orb).
  :ci {:extra-paths ["test"]
       :extra-deps {io.github.cognitect-labs/test-runner
                    {:git/sha "7284cda41fb9edc0f3bc6b6185cfb7138fc8a023"}}
       :main-opts ["-m" "cognitect.test-runner"]}

  ;; CLI entry — JVM-only. `clojure -M:cli --help`. Wraps `muschel.cli`
  ;; which implements bash-shaped invocation (-c, script.sh, -s, ...)
  ;; plus muschel-specific extensions (--sandbox, --root, ...).
  :cli {:main-opts ["-m" "muschel.cli"]}

  ;; Optional spindel backing for muschel.session.spindel.
  ;; Pull only when you want the JVM-only forkable session impl.
  ;; (Spindel itself has transitive deps that don't load in babashka.)
  :spindel {:extra-deps {org.replikativ/spindel {:mvn/version "0.1.12"}}}

  ;; Test the spindel-backed impl. Run with: clojure -M:test-spindel
  :test-spindel
  {:extra-paths ["test" "test-spindel"]
   :extra-deps  {org.replikativ/spindel {:mvn/version "0.1.12"}
                 io.github.cognitect-labs/test-runner
                 {:git/sha "7284cda41fb9edc0f3bc6b6185cfb7138fc8a023"}}
   :main-opts ["-m" "cognitect.test-runner" "--dir" "test-spindel"]}

  ;; ClojureScript (matches what shadow-cljs needs at runtime).
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs      {:mvn/version "2.28.23"}}}

  ;; Cross-runtime diff kernel smoke benchmark + native Git count oracle.
  :diff-lab {:extra-paths ["dev"]
             :main-opts ["-m" "muschel.diff-lab"]}

  :version-lab {:extra-paths ["dev"]
                :main-opts ["-m" "muschel.version-store-lab"]}

  ;; Build + deploy (jar, clojars, gh release, npm publish).
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 slipset/deps-deploy           {:mvn/version "0.2.2"}
                 io.github.borkdude/gh-release-artifact
                 {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}
                 babashka/fs                   {:mvn/version "0.5.22"}}
          :ns-default build}

  ;; Code formatting check (CI gates on this).
  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check" "src" "test"]}

  ;; Code formatting fix.
  :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
         :main-opts ["-m" "cljfmt.main" "fix" "src" "test"]}

  ;; Linting.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}

  ;; Check for outdated deps.
  :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.10.1241"}}
             :main-opts ["-m" "antq.core"]}}}
